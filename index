const SYNC_CONFIG = {
  DUMP_SHEET: 'DUPM FILE',
  KAM_SHEET: 'AD KAM MERCHANT',
  OUTPUT_SHEET: 'AD TEAM DATA',
  DUMP_HEADER_ROW: 3,
  DUMP_DATA_START_ROW: 4,
  KAM_HEADER_ROW: 1,
  KAM_DATA_START_ROW: 2
};

// ═════════════════════════════════════════════════════════════════════════════
// TRIGGERS & MENU
// ═════════════════════════════════════════════════════════════════════════════

function onEdit(e) {
  if (!e || !e.source) return;
  const editedSheetName = e.range.getSheet().getName();
  if (editedSheetName === SYNC_CONFIG.DUMP_SHEET || editedSheetName === SYNC_CONFIG.KAM_SHEET) {
    syncAdTeamData();
  }
}

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('AD TEAM DATA')
    .addItem('🔄 Sync Now', 'syncAdTeamData')
    .addItem('📊 Test Dashboard API', 'testDashboardAPI')
    .addToUi();
}

function createHourlyTrigger() {
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(t => {
    if (t.getHandlerFunction() === 'syncAdTeamData') {
      ScriptApp.deleteTrigger(t);
    }
  });
  ScriptApp.newTrigger('syncAdTeamData').timeBased().everyHours(1).create();
  SpreadsheetApp.getUi().alert('Hourly sync trigger installed!');
}

function findSheetLoose_(ss, targetName) {
  const exact = ss.getSheetByName(targetName);
  if (exact) return exact;
  const normalize = function (s) { return s.trim().toLowerCase(); };
  const target = normalize(targetName);
  const all = ss.getSheets();
  for (let i = 0; i < all.length; i++) {
    if (normalize(all[i].getName()) === target) return all[i];
  }
  return null;
}

// ═════════════════════════════════════════════════════════════════════════════
// SYNC FUNCTION
// ═════════════════════════════════════════════════════════════════════════════

function syncAdTeamData() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dumpSheet = findSheetLoose_(ss, SYNC_CONFIG.DUMP_SHEET);
  const kamSheet = findSheetLoose_(ss, SYNC_CONFIG.KAM_SHEET);
  const outputSheet = findSheetLoose_(ss, SYNC_CONFIG.OUTPUT_SHEET);

  if (!dumpSheet || !kamSheet || !outputSheet) {
    const actualNames = ss.getSheets().map(function (s) { return '"' + s.getName() + '"'; }).join(', ');
    const missing = [];
    if (!dumpSheet) missing.push('DUPM FILE');
    if (!kamSheet) missing.push('AD KAM MERCHANT');
    if (!outputSheet) missing.push('AD TEAM DATA');
    throw new Error('Could not find: ' + missing.join(', ') + '. Actual tabs: ' + actualNames);
  }

  const dumpLastRow = dumpSheet.getLastRow();
  const dumpLastCol = dumpSheet.getLastColumn();
  if (dumpLastRow < SYNC_CONFIG.DUMP_DATA_START_ROW) return;

  const dumpHeaders = dumpSheet.getRange(SYNC_CONFIG.DUMP_HEADER_ROW, 1, 1, dumpLastCol).getValues()[0];
  const dumpData = dumpSheet.getRange(SYNC_CONFIG.DUMP_DATA_START_ROW, 1, dumpLastRow - SYNC_CONFIG.DUMP_DATA_START_ROW + 1, dumpLastCol).getValues();

  const kamLastRow = kamSheet.getLastRow();
  if (kamLastRow < SYNC_CONFIG.KAM_DATA_START_ROW) return;

  const kamData = kamSheet.getRange(SYNC_CONFIG.KAM_DATA_START_ROW, 1, kamLastRow - SYNC_CONFIG.KAM_DATA_START_ROW + 1, 5).getValues();

  const kamMap = {};
  kamData.forEach(function (row) {
    const businessId = String(row[0]).trim();
    const businessName = String(row[1]).trim();
    if (!businessId && !businessName) return;
    const key = businessId + '|' + businessName;
    kamMap[key] = { assignedGroup: row[3], assignedKam: row[4] };
  });

  const outputRows = [];
  dumpData.forEach(function (row) {
    const businessId = String(row[0]).trim();
    const businessName = String(row[1]).trim();
    if (!businessId && !businessName) return;
    const key = businessId + '|' + businessName;
    const kamMatch = kamMap[key];
    if (kamMatch) {
      outputRows.push(row.concat([kamMatch.assignedGroup, kamMatch.assignedKam]));
    }
  });

  const outputHeaders = dumpHeaders.concat(['Assigned Group', 'Assigned KAM']);
  const numCols = outputHeaders.length;

  const kamGroups = {};
  const kamOrder = [];
  outputRows.forEach(function (row) {
    const kamName = row[row.length - 1] || '(Unassigned)';
    if (!kamGroups[kamName]) { kamGroups[kamName] = []; kamOrder.push(kamName); }
    kamGroups[kamName].push(row);
  });
  kamOrder.sort();

  outputSheet.clear();
  let currentRow = 1;
  const titleFormatRows = [];
  const headerFormatRows = [];

  kamOrder.forEach(function (kamName) {
    outputSheet.getRange(currentRow, 1).setValue(kamName);
    outputSheet.getRange(currentRow, 1, 1, numCols).merge();
    titleFormatRows.push(currentRow);
    currentRow++;

    outputSheet.getRange(currentRow, 1, 1, numCols).setValues([outputHeaders]);
    headerFormatRows.push(currentRow);
    currentRow++;

    const rows = kamGroups[kamName];
    outputSheet.getRange(currentRow, 1, rows.length, numCols).setValues(rows);
    currentRow += rows.length;
    currentRow++;
  });

  titleFormatRows.forEach(function (r) {
    outputSheet.getRange(r, 1, 1, numCols).setFontWeight('bold').setBackground('#4a86e8').setFontColor('#ffffff').setHorizontalAlignment('center').setFontSize(13);
  });
  headerFormatRows.forEach(function (r) {
    outputSheet.getRange(r, 1, 1, numCols).setFontWeight('bold').setBackground('#f3f3f3').setFontSize(11);
  });
  for (let c = 1; c <= numCols; c++) outputSheet.autoResizeColumn(c);

  Logger.log('Sync completed. Merchants: ' + outputRows.length);
}

// ═════════════════════════════════════════════════════════════════════════════
// DASHBOARD WEB APP API (FIXED for JSONP + CORS)
// ═════════════════════════════════════════════════════════════════════════════

function doGet(e) {
  const callback = e && e.parameter && e.parameter.callback ? e.parameter.callback : null;
  
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = findSheetLoose_(ss, 'AD TEAM DATA');
    
    if (!sheet) {
      return respond({ error: 'AD TEAM DATA sheet not found' }, callback, 404);
    }
    
    const lastRow = sheet.getLastRow();
    const lastCol = sheet.getLastColumn();
    if (lastRow < 3) {
      return respond({ merchants: [], lastUpdated: new Date().toISOString() }, callback);
    }
    
    const allData = sheet.getRange(1, 1, lastRow, lastCol).getValues();
    const headerRow = allData[0];
    const dateCols = [];
    const dateHeaders = [];
    
    for (let c = 0; c < headerRow.length; c++) {
      const h = String(headerRow[c]).trim();
      if (/^\d{1,2}\/\d{1,2}\/\d{4}/.test(h) ||
          /^\d{1,2}-\d{1,2}-\d{4}/.test(h) ||
          /^\d{4}-\d{2}-\d{2}/.test(h) ||
          /^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)/i.test(h)) {
        dateCols.push(c);
        dateHeaders.push(h.includes(' ') ? h.split(' ')[0] : h);
      }
    }
    
    const merchants = [];
    let currentKam = '';
    
    for (let r = 0; r < allData.length; r++) {
      const row = allData[r];
      const firstCell = String(row[0] || '').trim();
      if (!firstCell) continue;
      
      if (!row[1] && !/Business ID|onboarding|Assigned/i.test(firstCell)) {
        currentKam = firstCell;
        continue;
      }
      
      if (/Business ID/i.test(firstCell)) continue;
      
      if (firstCell && row[1]) {
        const businessId = String(row[0]).trim();
        const businessName = String(row[1]).trim();
        const onboarding = String(row[2] || '').trim();
        
        const orders = dateCols.map(c => {
          const val = row[c];
          if (val === '' || val === null || val === undefined) return 0;
          const num = Number(val);
          return isNaN(num) ? 0 : num;
        });
        
        const assignedGroup = String(row[row.length - 2] || '').trim();
        const assignedKam = String(row[row.length - 1] || currentKam).trim();
        
        merchants.push({
          id: businessId,
          name: businessName,
          onboarding: onboarding,
          kam: assignedKam || currentKam || 'Unassigned',
          group: assignedGroup || 'Unknown',
          orders: orders,
          dates: dateHeaders
        });
      }
    }
    
    return respond({
      merchants: merchants,
      lastUpdated: new Date().toISOString(),
      totalMerchants: merchants.length,
      dateRange: { from: dateHeaders[0] || '', to: dateHeaders[dateHeaders.length - 1] || '' }
    }, callback);
    
  } catch (err) {
    return respond({ error: err.message, stack: err.stack }, callback, 500);
  }
}

function respond(data, callback, statusCode) {
  statusCode = statusCode || 200;
  const json = JSON.stringify(data);
  
  if (callback) {
    // JSONP response
    const output = ContentService.createTextOutput(callback + '(' + json + ');')
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
    return output;
  } else {
    // Regular JSON with CORS
    const output = ContentService.createTextOutput(json)
      .setMimeType(ContentService.MimeType.JSON);
    return output;
  }
}

