function testDashboardAPI() {
  const result = doGet({ parameter: {} });
  const content = result.getContent();
  const data = JSON.parse(content);
  Logger.log('=== TEST ===');
  Logger.log('Merchants: ' + data.totalMerchants);
  Logger.log('Date range: ' + JSON.stringify(data.dateRange));
  if (data.merchants && data.merchants[0]) {
    Logger.log('Sample: ' + data.merchants[0].name + ' orders=' + JSON.stringify(data.merchants[0].orders));
  }
  let alertCount = 0;
  data.merchants.forEach(m => {
    let streak = 0;
    for (let i = m.orders.length - 1; i >= 0; i--) {
      if (m.orders[i] === 0) streak++; else break;
    }
    if (streak >= 2) { alertCount++; Logger.log('ALERT: ' + m.name + ' - ' + streak + ' days zero'); }
  });
  Logger.log('Alerts: ' + alertCount);
}

function manualSync() {
  syncAdTeamData();
  SpreadsheetApp.getUi().alert('Sync done!');
}
